# Platypus environment. Copy to .env and fill in. Never commit .env.
# `pnpm doctor` checks every variable below.

# --- Dial (voice + text) -------------------------------------------------
# API key from the Dial dashboard (sk_live_...).
DIAL_API_KEY=
# The id of the Dial number calls and messages are placed from (`dial number list`).
DIAL_FROM_NUMBER_ID=
# That number in E.164, e.g. +14155550100.
DIAL_NUMBER=
# Secret used to verify webhook HMAC signatures.
DIAL_WEBHOOK_SECRET=
# Text rail for owner messages: imessage | whatsapp | dial. Never "sms" to a non-Dial number (no 10DLC yet).
TEXT_CHANNEL=imessage

# --- Darwin (agent search) ----------------------------------------------
# Optional. Anonymous Search works without a key; an application key (directory:read)
# raises the rate limit. It never authorizes Act.
DARWIN_API_KEY=
# Optional. A Darwin OAuth token with human:actions whose credential is on the Act
# pilot allowlist. Used only when DARWIN_ACT_ENABLED=true (below).
DARWIN_ACT_TOKEN=
# Optional. Defaults to https://api.darwin.so/api.
DARWIN_API_BASE_URL=
# Optional. fake | real. Defaults to fake when DEMO_MODE=fakes and real when live.
DARWIN_IMPL=

# --- Anthropic (reply understanding, transcript mining) -----------------
ANTHROPIC_API_KEY=

# --- Runtime ------------------------------------------------------------
# Public HTTPS origin of the gateway (cloudflared tunnel). Dial webhooks and the Context MCP live under it.
PUBLIC_BASE_URL=
# Comma-separated E.164 numbers we are allowed to call or message. Today: the team's own phones only.
# ALLOWED_NUMBERS[0] is the demo auto shop ("Sal's Auto").
ALLOWED_NUMBERS=
# fakes: FakeDial + FakeDarwin + golden-path replay. live: real services.
DEMO_MODE=fakes

# --- Implementation switches (see docs/workstreams.md) -------------------
# Which VoiceTools the phone side calls: fake (FakeGateway) or real (the gateway package).
GATEWAY_IMPL=fake
# Which telephony the agent side drives: fake (FakeDial) or real (the voice package).
DIAL_IMPL=fake
# Off skips the Darwin step entirely; it is never simulated.
DARWIN_ENABLED=true
# Darwin Act (beta) handoff, only if Darwin enables it for us.
DARWIN_ACT_ENABLED=false
