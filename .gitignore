# Dependencies and build output
node_modules/
crates/platypus-audit/target/
dist/
coverage/
artifacts/
*.tsbuildinfo
.vite/

# Secrets. ALLOWED_NUMBERS, API keys and webhook secrets live only in .env.
.env
.env.*
!.env.example

# Local data. Databases hold real phone numbers once a real call has happened.
*.db
*.db-journal
*.db-wal
*.db-shm
data/

# Evidence and transcript dumps from real calls never enter the public repo.
evidence/
transcripts/
*.transcript.json
*.transcript.txt
recordings/
darwin-cache/

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log

# Local agent worktrees
.claude/worktrees/

# Generated by vite.config.ts from content/*.md
/packages/dashboard/about.html
/packages/dashboard/developers.html
/packages/dashboard/contact.html
/packages/dashboard/privacy.html
/packages/dashboard/404.html

