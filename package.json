{
  "name": "platypus",
  "version": "0.1.0",
  "private": true,
  "description": "One call makes any phone-only business bookable by every AI agent. Call once, agent-native forever.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "doctor": "tsx scripts/doctor.ts",
    "darwin:smoke": "tsx scripts/darwin-smoke.ts",
    "db:migrate": "tsx packages/shared/src/db/cli.ts migrate",
    "db:seed": "tsx packages/shared/src/db/cli.ts seed",
    "contracts:export": "tsx packages/shared/src/contracts/export.ts",
    "fixtures:golden-path": "tsx packages/shared/src/testing/fixtures/generate.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts/ci/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --project voice src/phone-side.test.ts && vitest run --passWithNoTests .e2e.test.ts",
    "test:eval": "vitest run --project text src/evals.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "tsx scripts/verify.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "live:reset": "DEMO_MODE=live tsx scripts/demo-reset.ts",
    "tunnel": "tsx scripts/tunnel.ts",
    "dial:register-mcp": "tsx packages/voice/scripts/register-mcp.ts",
    "dial:mcp-status": "tsx packages/voice/scripts/mcp-status.ts",
    "live": "tsx scripts/live.ts",
    "ci:hygiene": "tsx scripts/ci/repo-hygiene.ts",
    "ci:coverage-summary": "tsx scripts/ci/coverage-summary.ts",
    "ci:golden-path": "tsx scripts/ci/validate-golden-path.ts",
    "ci:eval-summary": "tsx scripts/ci/eval-summary.ts",
    "ci:bundle-budget": "tsx scripts/ci/bundle-budget.ts",
    "ci:smoke": "tsx scripts/ci/dashboard-smoke.ts",
    "dial:owner-sim": "tsx scripts/owner-sim.ts",
    "audit:log": "tsx scripts/audit-log.ts",
    "ci:audit-diff": "tsx scripts/ci/audit-differential.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "hono": "^4.13.13",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
